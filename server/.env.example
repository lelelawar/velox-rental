# Copy the PostgreSQL connection strings from the Supabase project settings.
# Use the pooled connection string for application runtime and the direct
# connection string for Prisma migrations.
DATABASE_URL="REPLACE_WITH_SUPABASE_POOLED_POSTGRES_CONNECTION_STRING"
DIRECT_URL="REPLACE_WITH_SUPABASE_DIRECT_POSTGRES_CONNECTION_STRING"
SUPABASE_URL="REPLACE_WITH_SUPABASE_PROJECT_URL"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="REPLACE_WITH_STORAGE_BUCKET_NAME"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
PORT=5000
NODE_ENV=development
CLIENT_URL="http://localhost:5173"
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=5242880
